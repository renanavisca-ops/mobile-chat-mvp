<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Auth deep links: Supabase email / password-reset links redirect
                 to tokychat://auth/callback (and tokychat://reset-password),
                 which reopen the installed app. Handled by NativeAuthLinks. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tokychat" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- Keeps a call alive (mic + CPU) while the screen is off / the app is in
             Picture-in-Picture. A video call keeps streaming the camera in the PiP
             floating window, so the service declares the camera type too. -->
        <service
            android:name=".CallForegroundService"
            android:foregroundServiceType="microphone|camera"
            android:exported="false" />

        <!-- Captures the screen (MediaProjection) while sharing during a call -->
        <service
            android:name=".ScreenCaptureService"
            android:foregroundServiceType="mediaProjection"
            android:exported="false" />

        <!-- Incoming-call push handling. The Firebase messaging plugin registers
             its own MessagingService in its manifest; we REPLACE it with ours so a
             data-only "incoming_call" push rings natively (full-screen call UI,
             WhatsApp-style) even when the app is killed. Ours extends the plugin's
             service and delegates every other message back to it, so normal push
             (notifications + JS delivery) is unaffected. -->
        <service
            android:name="io.capawesome.capacitorjs.plugins.firebase.messaging.MessagingService"
            tools:node="remove" />
        <service
            android:name=".TokyMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Transparent trampoline launched by the full-screen call notification.
             Wakes/unlocks the screen, then opens MainActivity (the web call UI). -->
        <activity
            android:name=".IncomingCallActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Handles the "Rechazar" action on the call notification (clears the
             ring locally without opening the app). -->
        <receiver
            android:name=".CallActionReceiver"
            android:exported="false" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Push notifications (Android 13+ prompts at runtime) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Full-screen incoming-call notification that rings over the lock screen
         even when the app is killed (like a real phone call). Calling apps
         qualify for this permission; declare the app's use as "Calling" / VoIP
         in the Play Console if prompted. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- Share location (one-time, @capacitor/geolocation) -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- WebRTC audio/video calls -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Keep calls alive with the screen off / in Picture-in-Picture (foreground
         service + wake lock). A video call keeps the camera streaming in the PiP
         floating window, hence FOREGROUND_SERVICE_CAMERA. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Screen sharing during a call (MediaProjection foreground service) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <!-- Save received photos/videos to the gallery (@capacitor-community/media).
         The app only SAVES (writes) to the gallery and never BROWSES/reads it —
         media is picked through the system file picker (<input type="file">),
         which needs no permission. So on Android 13+ no READ_MEDIA_IMAGES/VIDEO
         is requested (that avoids Google Play's "Photo and video permissions"
         declaration). Writing to MediaStore needs WRITE_EXTERNAL_STORAGE only up
         to Android 9; READ_EXTERNAL_STORAGE (<=Android 12) is kept for the legacy
         WebView file chooser. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Hardware implied by the permissions above is used opportunistically but
         NOT required to install the app. Without these explicit required="false"
         declarations, Play treats each implied feature as required and hides the
         app from devices lacking it (e.g. tablets without GPS or cameras without
         autofocus). CAMERA implies camera + camera.autofocus; ACCESS_*_LOCATION
         imply location + location.gps + location.network. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.location.network" android:required="false" />
</manifest>
