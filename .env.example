# Supabase Config
NEXT_PUBLIC_SUPABASE_URL=https://your-project-url.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App Config
# COUNTRY_ISO=GT

# Native push (FCM) for the iOS/Android apps. Paste the full Firebase service
# account JSON as a single-line string. When unset, native push is skipped and
# only Web Push (VAPID) runs. See MOBILE.md for how to obtain it.
# FCM_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com",...}
