# Supabase Config
NEXT_PUBLIC_SUPABASE_URL=https://your-project-url.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App Config
# COUNTRY_ISO=GT

# Base URL for the app's own /api/* backend routes. Leave EMPTY for the hosted
# web build (calls stay same-origin). The mobile build script sets this to the
# hosted origin so the bundled app calls the hosted backend. Public value only —
# never put a secret here.
# NEXT_PUBLIC_API_BASE_URL=https://mobile-chat-mvp.vercel.app

# Native push (FCM) for the iOS/Android apps. Paste the full Firebase service
# account JSON as a single-line string. When unset, native push is skipped and
# only Web Push (VAPID) runs. See MOBILE.md for how to obtain it.
# FCM_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com",...}

# Crash & error reporting (Sentry). All optional — when NEXT_PUBLIC_SENTRY_DSN
# is unset, Sentry is fully disabled and the build is unaffected.
# NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# NEXT_PUBLIC_SENTRY_ENV=production
# The three below are only needed to upload source maps at build time (nicer
# stack traces). Create a Sentry project, then fill these from its settings.
# SENTRY_ORG=your-sentry-org
# SENTRY_PROJECT=toky-chat
# SENTRY_AUTH_TOKEN=sntrys_...
